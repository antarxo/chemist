      "hExtent": "hydrogen color extent",
      "contrast": "global color contrast"
    },
    "surfaceAppearance": {
      "shellOpacity": "main cloud opacity",
      "glow": "emissive glow strength",
      "satinRoughness": "surface roughness / satin feel",
      "outerLayer": "secondary outer cloud layer opacity",
      "layerScale": "secondary layer scale"
    },
    "electronHints": {
      "lpDotSize": "lone-pair electron hint size",
      "lpDotOpacity": "lone-pair electron hint opacity",
      "bpDotSize": "bond-pair electron hint size",
      "bpDotOpacity": "bond-pair electron hint opacity",
      "bpBiasToN": "bond-pair visual position toward central/heavy atom"
    }
  },
