{
  "schemaVersion": "molecular-renderer-presets-v1",
  "project": "Μετροπόντικας της Χημείας",
  "rules": {
    "htmlPresetPolicy": "HTML reads presets only from this JSON. No fallback presets inside HTML.",
    "doNotInventControls": true,
    "appearanceModes": {
      "container": {
        "purpose": "small molecules inside reaction vessel",
        "particles": 0,
        "notes": "low-cost species models; no heavy outer layer unless explicitly set"
      },
      "zoom": {
        "purpose": "future magnifier / selected molecule",
        "notes": "may use richer satin/glow/outer layer later, not default for vessel"
      }
    }
  },
  "commonAppearancePreset": {
    "contrast": 1.01,
    "shellOpacity": 0.43,
    "glow": 0.0,
    "satinRoughness": 0.05,
    "outerLayer": 0.0,
    "layerScale": 1.11
  },
  "featureCatalog": {
    "shape": {
      "baseR": "base cloud radius",
      "bpAmp": "bond-pair lobe swelling",
      "bpRootNeck": "bond-pair root constriction",
      "bpNeck": "outer bond-pair neck",
      "bpBelly": "bond-pair belly",
      "lpAmp": "lone-pair lobe swelling/diffusion",
      "lpNeck": "lone-pair neck",
      "width": "lobe width",
      "neck": "inter-domain constriction",
      "hDepth": "visual hydrogen depth inside the cloud",
      "lpBias": "lone-pair visual position relative to central atom",
      "detail": "mesh resolution"
    },
    "colorDominance": {
      "nColor": "central/heavy atom color intensity",
      "nDominance": "central/heavy atom spatial dominance",
      "bondNDominance": "central/heavy atom dominance inside bond regions",
